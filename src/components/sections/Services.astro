---
import { t } from '../../i18n/utils';
import SectionHead from '../ui/SectionHead.astro';
import { services } from '../../data/services';
import ArrowIcon from '../ui/ArrowIcon.astro';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const revealClasses = ['reveal', 'reveal d1', 'reveal d2'];
---

<section id="services" data-section="services" data-screen-label="04 Services">
  <SectionHead num="04" title={t('services.title', locale)} file={t('services.file', locale)} />

  <div class="services-list">
    {
      services.map((service, i) => (
        <a class={`service ${revealClasses[i % revealClasses.length]}`} href="#contact">
          <span class="service-num">{service.num}</span>
          <span class="service-title">{service.title[locale]}</span>
          <span class="service-desc">{service.description[locale]}</span>
          <span class="service-arrow">
            <ArrowIcon size={14} />
          </span>
        </a>
      ))
    }
  </div>
</section>
