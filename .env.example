# Copy this file to `.env` and fill in the values.
# Only PUBLIC_* variables are exposed to the browser.

# Cloudflare Web Analytics — privacy-first, no-cookie.
# Get the token from the Cloudflare dashboard → Web Analytics → Add a site → JS Snippet.
# If unset, the beacon script is not injected and the CSP `connect-src` Cloudflare entry is harmless.
PUBLIC_CF_BEACON_TOKEN=
